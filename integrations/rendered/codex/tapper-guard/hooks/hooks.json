{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit|Shell|exec_command|apply_patch|write_file|edit_file|delete_file|move_file|rename_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "tap hook pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
