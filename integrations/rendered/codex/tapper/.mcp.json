{
  "mcpServers": {
    "tapper": {
      "command": "tap",
      "args": ["mcp"],
      "env_vars": [
        "HOME",
        "TAP_FLIGHT",
        "TAP_HARNESS",
        "TAP_MODEL",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME"
      ]
    }
  }
}
