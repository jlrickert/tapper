{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "tap hook session-start",
            "timeout": 5,
            "statusMessage": "Restoring Tapper orientation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tap hook pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
