{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tap hook pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(tapper:)?tapper-flight-switch$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "tapper",
            "tool": "flight_switch_control",
            "input": {
              "ref": "${command_args}"
            }
          }
        ]
      }
    ]
  }
}
